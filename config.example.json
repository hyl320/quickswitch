{
  "version": 1,
  "start_with_windows": false,
  "start_minimized": false,
  "close_to_tray": true,
  "notifications": true,
  "bindings": [
    {
      "id": "ex01",
      "name": "示例：终端 1",
      "hotkey": "Ctrl+Alt+1",
      "enabled": false,
      "process": "WindowsTerminal.exe",
      "title": "",
      "window_class": "",
      "exclude_title": "",
      "index": 1,
      "override": true,
      "when": "activate",
      "launch": "",
      "launch_cwd": "",
      "wait_seconds": 8,
      "launch_gap": 0.8
    },
    {
      "id": "ex02",
      "name": "示例：VS Code 项目",
      "hotkey": "Ctrl+Alt+2",
      "enabled": false,
      "process": "Code.exe",
      "title": "项目名",
      "window_class": "",
      "exclude_title": "",
      "index": 0,
      "override": true,
      "when": "activateOrLaunch",
      "launch": "code D:\\proj",
      "launch_cwd": "D:\\proj",
      "wait_seconds": 12,
      "launch_gap": 0.8
    },
    {
      "id": "ex03",
      "name": "示例：开发场景（IDE + 终端 + 浏览器）",
      "hotkey": "Ctrl+Alt+3",
      "enabled": false,
      "process": "Code.exe",
      "title": "my-project",
      "window_class": "",
      "exclude_title": "",
      "index": 0,
      "override": true,
      "when": "activateOrLaunch",
      "launch": "wt.exe -w 0 nt pwsh -NoExit -Command \"cd D:\\proj\"\ncode D:\\proj\nstart https://github.com",
      "launch_cwd": "",
      "launch_gap": 1.0,
      "wait_seconds": 20
    }
  ]
}
